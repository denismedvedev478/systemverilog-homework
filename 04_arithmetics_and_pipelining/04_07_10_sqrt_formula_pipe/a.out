 .timescale 0 0;
S_0x5566c4bd8730 .scope module, "isqrt_test" "isqrt_test" 3 1;
 .timescale 0 0;
v0x5566c4bd9d20_0 .var "clk", 0 0;
v0x5566c4bda400_0 .var "rst", 0 0;
    .scope S_0x5566c4bd8730;
T_0 ;
    %pushi/vec4 0, 0, 1;
    %store/vec4 v0x5566c4bd9d20_0, 0, 1;
    %end;
    .thread T_0, $init;
    .scope S_0x5566c4bd8730;
T_1 ;
    %pushi/vec4 0, 0, 1;
    %store/vec4 v0x5566c4bd9d20_0, 0, 1;
    %pushi/vec4 0, 0, 1;
    %store/vec4 v0x5566c4bda400_0, 0, 1;
    %fork t_1, S_0x5566c4bd8730;
    %fork t_2, S_0x5566c4bd8730;
    %fork t_3, S_0x5566c4bd8730;
    %join/detach 3;
    %jmp t_0;
t_1 ;
T_1.0 ;
    %delay 5, 0;
    %load/vec4 v0x5566c4bd9d20_0;
    %inv;
    %store/vec4 v0x5566c4bd9d20_0, 0, 1;
    %jmp T_1.0;
    %end;
t_2 ;
    %pushi/vec4 1, 0, 1;
    %store/vec4 v0x5566c4bda400_0, 0, 1;
    %delay 15, 0;
    %pushi/vec4 0, 0, 1;
    %store/vec4 v0x5566c4bda400_0, 0, 1;
    %end;
t_3 ;
    %delay 100, 0;
    %vpi_call/w 3 16 "$finish" {0 0 0};
    %end;
    .scope S_0x5566c4bd8730;
t_0 ;
    %end;
    .thread T_1;
